# Copy to .env.prod and edit. Never commit the real file.
APP_ENV=production
PUBLIC_API_URL=https://app.example.com
CORS_ORIGINS=["https://app.example.com"]

# ── Database ─────────────────────────────────────────────────────────
# Set DATABASE_URL directly — docker-compose.prod.yml no longer builds it
# from POSTGRES_* vars, so this is read as-is by both the app and Alembic
# (ALEMBIC_URL falls back to this with the driver rewritten to +psycopg
# if not set separately — see apps/api/alembic/env.py).
#
# Managed Postgres (Neon, RDS, ...):
#   DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/DB?sslmode=require
#
# Local `postgres` service instead (docker compose --profile local-db up):
#   DATABASE_URL=postgresql+asyncpg://buchuchet:${POSTGRES_PASSWORD}@postgres:5432/buchuchet
# then also set:
POSTGRES_USER=buchuchet
POSTGRES_PASSWORD=__set_me__
POSTGRES_DB=buchuchet
DATABASE_URL=__set_me__

JWT_SECRET=__rotate_per_environment__
JWT_TTL_MIN=120

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=gpt-4o-mini

STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
# Public-facing endpoint for presigned URLs, if it differs from S3_ENDPOINT
# (the api container talks to MinIO over the internal Docker network, but
# presigned links handed to browsers need a publicly resolvable host —
# see app/core/config.py's s3_public_endpoint for the full explanation).
S3_PUBLIC_ENDPOINT=
S3_BUCKET=buchuchet
S3_ACCESS_KEY=__set_me__
S3_SECRET_KEY=__set_me__

# Email (Resend or Postmark)
EMAIL_PROVIDER=resend     # resend|postmark|console
EMAIL_FROM=Wagwan <noreply@example.com>
RESEND_API_KEY=
POSTMARK_TOKEN=
APP_BASE_URL=https://app.example.com

# Cloudflare Turnstile (bot protection on register/login). Leave both unset
# to disable — register/login work normally without a captcha in that case.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# See .env.example for the full explanation. Leave false until Resend above
# is actually configured and delivering mail.
REQUIRE_EMAIL_VERIFICATION=false

# Monitoring
SENTRY_DSN=
SENTRY_TRACES=0.1
