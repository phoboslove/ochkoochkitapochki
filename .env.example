# =====================================================================
# Buchuchet — environment template. Copy to apps/api/.env (backend) and
# apps/web/.env.local (frontend) and fill in your own values.
# Do NOT commit the real .env / .env.local files — see .gitignore.
# =====================================================================

# ── Database (Postgres) ────────────────────────────────────────────────
# Local dev (no infra):  sqlite+aiosqlite:///./buchuchet.db
# Neon / Supabase / RDS: postgresql+asyncpg://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./buchuchet.db

# ── API server ─────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=replace-with-32-random-bytes-hex
JWT_ALG=HS256
JWT_TTL_MIN=120

# ── Frontend ──────────────────────────────────────────────────────────
# Used by apps/web — copy to apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── AI (OpenAI / Anthropic) ───────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=gpt-3.5-turbo

# ── Storage (S3-compatible / MinIO / local) ───────────────────────────
STORAGE_BACKEND=local        # local | s3
STORAGE_DIR=./storage/local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=buchuchet
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── OCR ───────────────────────────────────────────────────────────────
OCR_PROVIDER=mock            # mock | azure | ocr_space
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=
OCR_SPACE_API_KEY=
OCR_SPACE_LANGUAGE=rus       # eng | rus | kaz

# ── Email (Resend / Postmark) ─────────────────────────────────────────
EMAIL_PROVIDER=console       # console | resend | postmark
EMAIL_FROM="Wagwan <noreply@example.com>"
RESEND_API_KEY=
POSTMARK_TOKEN=
APP_BASE_URL=http://localhost:3000

# ── Monitoring (Sentry) ───────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES=0.1
APP_ENV=development

# ── Per-tenant integrations are stored in DB (NOT here) ───────────────
# WhatsApp / Telegram / Bitrix / Kaspi / Ozon / 1C
# Configure them in the /integrations page (encrypted in `integrations.secrets`).
